%include {
//! A Calculator

/// The Token Type
pub const Token = struct {
    kind: TokenKind,
    span: []const u8,
    val: ?f64,

    pub const empty: Token = .{ .kind = .end_of_input, .span = "", .val = null };

    pub fn lit(kind: TokenKind) Token {
        var tok: Token = .empty;
        tok.kind = kind;
        return tok;
    }
};

const WeedWhacker = opaque {};

}

%extra_context {answer: f64}

%token_type "Token"
// %token_enum_integer u8
%token_destructor {
    // buh
}

%type expr f64
%type term f64
%type factor f64

%destructor term "// float, no destructor"

calc ::= expr(A). { answer = A; }

expr(A) ::= expr(B) PLUS|FOO(O) term(C). {
    _ = .{"has C in it", @O};
    // std.debug.print("PLUS? {t}\n", .{@O});
    A = B + C;
}
expr(A) ::= expr(B) MINUS term(C). { A = B - C; }

/* This generates the same code as the term-factor version,
** with less fuss.  Prefer this style.  Note: it's illegal
** to assign the same alias unless the rule types are also
** the same. */
expr(A) ::= term(A).
term(A) ::= term(B) TIMES factor(C). { A = B * C; }
term(A) ::= term(B) DIVIDE factor(C). { A = B / C; }

/* Note: it is illegal to refer to B in the below, after
** encountering the magic comment.  Why?  Ask DRH! */
term(A) ::= factor(B). {
    A = B;
    // A-overwrites-B
}

%type NUMBER {f64}

factor(A) ::= NUMBER(N). { A = N.val.?; }
factor(A) ::= LPAREN expr(E) RPAREN. { A = E; }

%code {
//| Tokenizer for calc.zy

const assert = std.debug.assert;

pub const Tokenizer = struct {
    span: []const u8,
    idx: usize,

    pub fn init(span: []const u8) Tokenizer {
        return .{ .span = span, .idx = 0 };
    }

    /// Get the next token, or an `error.SyntaxError`, or `null`
    /// if there are no more tokens available on the span.
    pub fn next(tok: *Tokenizer) error{SyntaxError}!?Token {
        if (tok.idx == tok.span.len) return null;
        var idx = tok.idx;
        var this: Token = .empty;
        tokenize: switch (tok.span[idx]) {
            '+' => this = Token.lit(.PLUS),
            '-' => this = Token.lit(.MINUS),
            '*' => this = Token.lit(.TIMES),
            '/' => this = Token.lit(.DIVIDE),
            '(' => this = Token.lit(.LPAREN),
            ')' => this = Token.lit(.RPAREN),
            ' ', '\t', '\n' => {
                if (idx + 1 == tok.span.len) {
                    tok.idx = tok.span.len;
                    return null;
                }
                idx += 1;
                continue :tokenize tok.span[idx];
            },
            '0'...'9' => {
                this.kind = .NUMBER;
                const start = idx;
                idx += 1;
                // TODO: `.`, scientific notation maybe?
                while (idx < tok.span.len and '0' <= tok.span[idx] and tok.span[idx] <= '9') : (idx += 1) {}
                this.val = std.fmt.parseFloat(f64, tok.span[start..idx]) catch return error.SyntaxError;
                tok.idx = idx;
                return this;
            },
            else => return error.SyntaxError,
        }
        tok.idx = idx + 1;
        return this;
    }
};

test "1 + 2" {
    var parser = try Parser.create(std.testing.allocator, 0.0);
    defer parser.destroy();
    var tok = Tokenizer.init("1 + (2 * 2 - 2)");
    while (try tok.next()) |t| {
        try parser.parse(t.kind, t);
    } else {
        try parser.finalize();
    }
    try std.testing.expectApproxEqAbs(3.0, parser.answer, 0.0001);
}

}
