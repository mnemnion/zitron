%include {
const zitron_no_error_recovery = {};

const Stats = struct {
    syntax_errors: usize = 0,
    accepts: usize = 0,
};
}

%extra_context {stats: *Stats}
%token_type void

%wildcard W.

%syntax_error {
    stats.syntax_errors += 1;
    return error.SyntaxError;
}

%parse_accept {
    stats.accepts += 1;
}

start ::= P aa D.
start ::= P bb W Z.
start ::= Q aa E.
start ::= Q bb W Z.
aa ::= C.
bb ::= C.

%code {
//| Tests

fn parseTokens(tokens: []const TokenKind) !Stats {
    var stats: Stats = .{};
    var parser = try Parser.create(std.testing.allocator, &stats);
    defer parser.destroy();

    for (tokens) |token| {
        parser.parse(token, {}) catch |err| switch (err) {
            error.SyntaxError => return stats,
        };
    }
    parser.finalize() catch |err| switch (err) {
        error.SyntaxError => return stats,
    };
    return stats;
}

test "compression preserves an exact reduction before a wildcard reduction" {
    const stats = try parseTokens(&.{ .P, .C, .D });
    try std.testing.expectEqual(@as(usize, 0), stats.syntax_errors);
    try std.testing.expectEqual(@as(usize, 1), stats.accepts);
}
}
